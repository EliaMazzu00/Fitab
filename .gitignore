# Build output
bin/
obj/
build/

# Pacchetti dell'app: artefatti, non sorgenti (decine di MB l'uno).
# Git conserva ogni versione per sempre e i binari non si comprimono per
# differenze, quindi ogni build committata peserebbe sul clone di chiunque,
# per sempre. Vanno distribuiti dalle Release, non dal repository.
*.apk
*.aab
*.ipa

# Cartella di lavoro per l'estrazione dell'APK originale
extract/

# IDE
.vs/
.idea/
*.user
*.suo

# macOS
.DS_Store
