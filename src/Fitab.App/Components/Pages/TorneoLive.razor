@page "/live/{Codice}"
@using Fitab.App.Servizi
@implements IAsyncDisposable
@inject FitabData Dati
@inject SessioneUtente Utente
@inject IJSRuntime JS
@inject NavigationManager Nav

@* "La mia serata": una sola schermata per tutto il torneo.

   Nell'app attuale seguire una serata richiede tre livelli di navigazione
   (elenco live -> elenco turni -> punti del turno) e nessun aggiornamento
   automatico: per vedere i risultati di un tavolo appena caricato bisogna
   uscire dalla pagina e rientrarci. Qui i turni sono chip, la tabella cambia
   sotto senza navigare, e i dati si aggiornano da soli. *@

<Intestazione Titolo="@(_torneo?.Descrizione ?? "Torneo live")" Indietro="true"
             SuIndietro="@(() => Nav.NavigateTo("live"))" />

@if (_torneo is not null)
{
    <div class="testata-live">
        <div style="display:flex;align-items:center;gap:var(--sp-2)">
            @if (_torneo.EDiOggi)
            {
                <span class="chip chip--live"><span class="chip__pallino"></span> IN CORSO</span>
            }
            else
            {
                <span class="chip">@_torneo.Data?.ToString("dd/MM/yyyy")</span>
            }
            @if (_torneo.Rilevanza != Rilevanza.Sconosciuta)
            {
                <span class="chip chip--primario">@_torneo.Rilevanza.Descrizione()</span>
            }
        </div>

        <div class="testo-sm testo-forte" style="margin-top:var(--sp-2)">@_torneo.Circolo</div>

        <div class="testata-live__dati">
            <span>@_torneo.NumeroTavoli tavoli</span>
            <span>@_torneo.TurniTotali turni</span>
            @if (!string.IsNullOrWhiteSpace(_torneo.Arbitro))
            {
                <span class="troncato">arb. @_torneo.Arbitro</span>
            }
        </div>
    </div>
}

@if (_turniGiocati.Count > 0)
{
    <div class="turni">
        @* La generale sta per prima ed e' la vista di partenza: durante una serata
           la domanda non e' "come e' andato il 4° turno" ma "a che punto sono". *@
        <button class="turno turno--generale @(_vistaGenerale ? "attivo" : "")"
                @onclick="MostraGenerale">
            Generale
        </button>

        @foreach (var turno in _turniGiocati)
        {
            <button class="turno @(!_vistaGenerale && turno.Chiave == _turnoScelto?.Chiave ? "attivo" : "")"
                    @onclick="@(() => CambiaTurno(turno))">
                @turno.EtichettaBreve
                @if (turno.SonoQui)
                {
                    <span class="turno__io" title="Stai giocando in questo turno"></span>
                }
            </button>
        }
    </div>
}

<div class="barra-live @(_errore is not null ? "barra-live--errore" : "")">
    <span>
        @if (_errore is not null)
        {
            @_errore
            <text> Ultimi dati di @Trascorso.</text>
        }
        else if (_ultimoAggiornamento is null)
        {
            <text>In attesa dei risultati…</text>
        }
        else
        {
            <text>Aggiornato @Trascorso</text>
        }
    </span>

    <button class="stato-dati__aggiorna" @onclick="AggiornaOra" disabled="@_inAggiornamento">
        <Icona Nome="aggiorna" Dimensione="15" Classe="@(_inAggiornamento ? "gira" : null)" />
        @(_inAggiornamento ? "Aggiorno…" : "Aggiorna")
    </button>
</div>

<div class="contenuto">

    @if (_caricamentoIniziale)
    {
        <Scheletro Quante="3" />
    }
    else if (_turniGiocati.Count == 0)
    {
        <StatoVuoto Titolo="Nessun turno disponibile"
                    Messaggio="I turni compaiono quando l'arbitro avvia il torneo."
                    NomeIcona="orologio" />
    }
    else if (_vistaGenerale)
    {
        @if (_generale is null && _generaleInCaricamento)
        {
            <Scheletro Quante="4" />
        }
        else if (_generale is null)
        {
            <StatoVuoto Titolo="Classifica non ancora disponibile"
                        Messaggio="Compare appena l'arbitro chiude il primo turno."
                        NomeIcona="orologio" />
        }
        else
        {
            <div class="riepilogo">
                <div class="riepilogo__titolo">Classifica generale</div>
                <div class="riepilogo__sotto">@_generale.Descrizione</div>

                @if (_generale.TurnoInCorso)
                {
                    <div class="riepilogo__turno">
                        <span class="chip chip--live"><span class="chip__pallino"></span>
                            @(_generale.NumeroTurnoInCorso)° turno in corso</span>
                        <span class="testo-xs testo-secondario">
                            @if (_generale.AbbinamentiNoti)
                            {
                                <text>@_generale.TavoliInCorso.Count tavoli — i risultati entrano tutti insieme quando l'arbitro chiude il turno.</text>
                            }
                            else
                            {
                                <text>Gli abbinamenti li decide il movimento Mitchell, non la classifica.</text>
                            }
                        </span>
                    </div>
                }
            </div>

            @* La propria situazione, col tavolo del turno che si sta giocando *@
            @if (_generale.Mia is { } mia)
            {
                <div class="io-fissa">
                    <div class="io-fissa__etichetta">La tua posizione</div>
                    <div style="display:flex;align-items:center;gap:var(--sp-3);margin-top:var(--sp-1)">
                        <span style="font-size:var(--testo-2xl);font-weight:var(--peso-forte);line-height:1">
                            @mia.Posizione°
                        </span>
                        @if (mia.DeltaPosizione != 0)
                        {
                            <span class="delta @(mia.InRisalita ? "delta--su" : "delta--giu")">
                                <Icona Nome="@(mia.InRisalita ? "su" : "giu")" Dimensione="14" />
                                @Math.Abs(mia.DeltaPosizione)
                            </span>
                        }
                        <div style="flex:1;min-width:0">
                            <div class="testo-sm">@mia.DescrizioneCoppia</div>
                            <div class="testo-xs testo-secondario" style="margin-top:3px">
                                VP @mia.VP · MP @mia.MP
                                @if (mia.RisultatoUltimoTurnoNoto)
                                {
                                    <text> · ultimo turno @Segno(mia.VPUltimoTurno) VP</text>
                                }
                            </div>
                        </div>
                    </div>

                    @if (_generale.TurnoInCorso && mia.TavoloInCorso > 0)
                    {
                        <div class="turno-corrente">
                            <div class="turno-corrente__riga">
                                <span class="tavolo tavolo--mio">
                                    <Icona Nome="tavolo" Dimensione="12" /> Tavolo @mia.TavoloInCorso
                                </span>
                                @if (mia.ARiposo)
                                {
                                    <span class="testo-xs testo-secondario">sei di riposo in questo turno</span>
                                }
                                else
                                {
                                    <span class="testo-xs testo-secondario troncato">
                                        contro @mia.Avversario (@mia.PosizioneAvversario°)
                                    </span>
                                }
                            </div>

                        </div>
                    }
                </div>
            }

            <div class="classifica">
                <div class="classifica__intestazione">
                    <span>Pos</span>
                    <span>Coppia@(_generale.AbbinamentiNoti ? " e tavolo in corso" : "")</span>
                    <span style="text-align:right">VP</span>
                    <span style="text-align:right">MP</span>
                </div>

                @foreach (var riga in _generale.RigheReali)
                {
                    <div @key="(riga.ChiaveCoppia, riga.Posizione, riga.VP, riga.MP)"
                         id="@IdRiga(riga)"
                         class="riga-live @(riga.SonoIo ? "riga-live--io" : "")">

                        <div class="riga-live__posizione">
                            @riga.Posizione
                            @if (riga.DeltaPosizione != 0)
                            {
                                <span class="delta @(riga.InRisalita ? "delta--su" : "delta--giu")">
                                    @(riga.InRisalita ? "▲" : "▼")@Math.Abs(riga.DeltaPosizione)
                                </span>
                            }
                        </div>

                        <div class="riga-live__coppia">
                            <div class="selezionabile">
                                <div>
                                    @if (riga.SonoIo)
                                    {
                                        <span class="distintivo-io">TU</span>
                                    }
                                    @Primo(riga.Dati)
                                </div>
                                @if (Secondo(riga.Dati) is { Length: > 0 } secondo)
                                {
                                    <div>@secondo</div>
                                }
                            </div>

                            @if (riga.TavoloInCorso > 0)
                            {
                                <div style="margin-top:3px">
                                    <span class="tavolo @(riga.SonoIo ? "tavolo--mio" : "")">
                                        <Icona Nome="tavolo" Dimensione="12" /> Tavolo @riga.TavoloInCorso
                                    </span>
                                    @if (riga.ARiposo)
                                    {
                                        <span class="testo-xs testo-tenue"> riposo</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="riga-live__vp">
                            @riga.VP
                            @if (riga.RisultatoUltimoTurnoNoto && riga.VPUltimoTurno != 0)
                            {
                                <div class="riga-live__guadagno">@Segno(riga.VPUltimoTurno)</div>
                            }
                        </div>
                        <div class="riga-live__mp">@riga.MP</div>
                    </div>
                }
            </div>

            <p class="testo-xs testo-tenue" style="margin-top:var(--sp-3);text-align:center">
                VP = punti vittoria · MP = punti match — entrambi sommati da inizio torneo
            </p>
        }
    }
    else if (_righe.Count == 0 && _turnoInCaricamento)
    {
        <Scheletro Quante="4" />
    }
    else if (_righe.Count == 0)
    {
        <StatoVuoto Titolo="Turno non ancora iniziato"
                    Messaggio="Appena arrivano i primi risultati li vedrai qui, senza dover aggiornare."
                    NomeIcona="tavolo" />
    }
    else
    {
        @* La propria posizione resta sempre visibile in cima *@
        @if (_miaRiga is not null)
        {
            <div class="io-fissa">
                <div class="io-fissa__etichetta">La tua posizione</div>
                <div style="display:flex;align-items:center;gap:var(--sp-3);margin-top:var(--sp-1)">
                    <span style="font-size:var(--testo-2xl);font-weight:var(--peso-forte);
                                 line-height:1">
                        @_miaRiga.Dati.Posizione°
                    </span>
                    @if (_miaRiga.DeltaPosizione != 0)
                    {
                        <span class="delta @(_miaRiga.InRisalita ? "delta--su" : "delta--giu")">
                            <Icona Nome="@(_miaRiga.InRisalita ? "su" : "giu")" Dimensione="14" />
                            @Math.Abs(_miaRiga.DeltaPosizione)
                        </span>
                    }
                    <div style="flex:1;min-width:0">
                        <div class="testo-sm">@Primo(_miaRiga.Dati)</div>
                        @if (Secondo(_miaRiga.Dati) is { Length: > 0 } compagno)
                        {
                            <div class="testo-sm">@compagno</div>
                        }
                        <div style="display:flex;align-items:center;gap:var(--sp-2);
                                    margin-top:3px;flex-wrap:wrap">
                            <span class="tavolo tavolo--mio">
                                <Icona Nome="tavolo" Dimensione="12" /> Tavolo @_miaRiga.Dati.NumTavolo
                            </span>
                            <span class="testo-xs testo-secondario">
                                VP @_miaRiga.Dati.VP · MP @_miaRiga.Dati.MP
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (_mioTavolo is not null)
        {
            <button class="interruttore-tavolo @(_soloMioTavolo ? "attivo" : "")"
                    @onclick="@(() => _soloMioTavolo = !_soloMioTavolo)">
                <Icona Nome="tavolo" Dimensione="18" />
                @(_soloMioTavolo
                    ? $"Mostro solo il tavolo {_mioTavolo} — tocca per vedere tutti"
                    : $"Vedi solo il mio tavolo ({_mioTavolo})")
            </button>
        }

        <div class="classifica">
            <div class="classifica__intestazione">
                <span>Pos</span>
                <span>Coppia e tavolo</span>
                <span style="text-align:right">VP</span>
                <span style="text-align:right">MP</span>
            </div>

            @foreach (var riga in _righeVisibili)
            {
                @* La chiave include i valori: quando cambiano, Blazor ricrea
                   l'elemento e l'animazione di evidenziazione riparte. *@
                <div @key="(riga.Dati.Codice, riga.Dati.Posizione, riga.Dati.VP, riga.Dati.MP)"
                     id="@IdRiga(riga)"
                     class="riga-live @(riga.Dati.SonoIo ? "riga-live--io" : "") @(!riga.Dati.SonoIo && _mioTavolo == riga.Dati.NumTavolo ? "riga-live--mio-tavolo" : "") @(riga.Cambiata ? "riga-live--cambiata" : "")">

                    <div class="riga-live__posizione">
                        @riga.Dati.Posizione
                        @if (riga.DeltaPosizione != 0)
                        {
                            <span class="delta @(riga.InRisalita ? "delta--su" : "delta--giu")">
                                @(riga.InRisalita ? "▲" : "▼")@Math.Abs(riga.DeltaPosizione)
                            </span>
                        }
                    </div>

                    <div class="riga-live__coppia">
                        @* Due righe invece della coppia su una sola: a larghezza
                           telefono i nomi uniti dal trattino andavano a capo fino a
                           quattro righe, rendendo la tabella imprevedibile. *@
                        @* Niente troncamento sui nomi: in una classifica sapere
                           chi e' la coppia e' il dato, non un dettaglio. Se un nome
                           non ci sta va a capo. *@
                        <div class="selezionabile">
                            <div>
                                @if (riga.Dati.SonoIo)
                                {
                                    <span class="distintivo-io">TU</span>
                                }
                                @Primo(riga.Dati)
                            </div>
                            @if (Secondo(riga.Dati) is { Length: > 0 } secondo)
                            {
                                <div>@secondo</div>
                            }
                        </div>
                        <div style="margin-top:3px">
                            <span class="tavolo @(_mioTavolo == riga.Dati.NumTavolo ? "tavolo--mio" : "")">
                                <Icona Nome="tavolo" Dimensione="12" /> Tavolo @riga.Dati.NumTavolo
                            </span>
                        </div>
                    </div>

                    <div class="riga-live__vp">@riga.Dati.VP</div>
                    <div class="riga-live__mp">@riga.Dati.MP</div>
                </div>
            }
        </div>

        <p class="testo-xs testo-tenue" style="margin-top:var(--sp-3);text-align:center">
            VP = punti vittoria · MP = punti match
        </p>
    }
</div>

@if (MostraPulsanteVaiAMe)
{
    <button class="vai-a-me" @onclick="VaiAMe">
        <Icona Nome="persona" Dimensione="18" /> La mia posizione
    </button>
}

@code {
    [Parameter] public string Codice { get; set; } = "";

    private PollingLive? _polling;
    private PollingGenerale? _pollingGenerale;
    private DotNetObjectReference<TorneoLive>? _riferimento;
    private string? _idVisibilita;

    private LiveTorneo? _torneo;
    private IReadOnlyList<LiveTurno> _turni = [];

    /// <summary>
    /// I soli turni con risultati, in ordine di gioco. Esclude lo pseudo-turno
    /// "0-P" che il backend mette in coda: contiene gli abbinamenti, non i punti,
    /// e come chip mostrerebbe una tabella tutta a zero.
    /// </summary>
    private IReadOnlyList<LiveTurno> _turniGiocati = [];
    private LiveTurno? _turnoScelto;
    private IReadOnlyList<RigaLive> _righe = [];
    private RigaLive? _miaRiga;

    /// <summary>
    /// Vista di partenza: la classifica generale. I chip dei turni restano per chi
    /// vuole rivedere una tappa, ma la domanda di una serata e' "a che punto sono".
    /// </summary>
    private bool _vistaGenerale = true;

    private ClassificaGenerale? _generale;

    // "Sto aspettando la rete" e "non c'e' niente da mostrare" sono due cose
    // diverse, e mostrare la seconda al posto della prima e' una bugia: diceva
    // "Turno non ancora iniziato" su turni che i risultati ce li avevano gia'.
    private bool _generaleInCaricamento = true;
    private bool _turnoInCaricamento;

    private bool _soloMioTavolo;

    /// <summary>Tavolo del tesserato nel turno mostrato, se sta giocando qui.</summary>
    private int? _mioTavolo => _miaRiga?.Dati.NumTavolo;

    /// <summary>Righe da disegnare: tutte, o solo quelle del proprio tavolo.</summary>
    private IReadOnlyList<RigaLive> _righeVisibili =>
        _soloMioTavolo && _mioTavolo is { } tavolo
            ? _righe.Where(r => r.Dati.NumTavolo == tavolo).ToList()
            : _righe;

    private DateTimeOffset? _ultimoAggiornamento;
    private string? _errore;
    private bool _caricamentoIniziale = true;
    private bool _inAggiornamento;

    private string Trascorso
    {
        get
        {
            if (_ultimoAggiornamento is null) return "—";
            var e = DateTimeOffset.Now - _ultimoAggiornamento.Value;
            if (e < TimeSpan.FromSeconds(10)) return "adesso";
            if (e < TimeSpan.FromMinutes(1)) return $"{(int)e.TotalSeconds} secondi fa";
            if (e < TimeSpan.FromHours(1)) return $"{(int)e.TotalMinutes} minuti fa";
            return $"{(int)e.TotalHours} ore fa";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _polling = new PollingLive(Dati.Api);
        _polling.Aggiornato += SuAggiornamento;

        _pollingGenerale = new PollingGenerale(Dati);
        _pollingGenerale.Aggiornato += SuAggiornamentoGenerale;

        // Prima di toccare la rete: se di questo torneo abbiamo gia' una
        // fotografia su disco, la schermata si disegna adesso.
        await PrimoDisegnoDallaCache();

        await CaricaTorneoETurni();
        _caricamentoIniziale = false;
    }

    /// <summary>
    /// Ridisegna l'ultimo stato conosciuto senza chiedere niente al server. Non e'
    /// un'ottimizzazione di comodo: e' la differenza fra entrare e vedere la
    /// classifica e entrare e guardare una schermata vuota per due secondi.
    /// </summary>
    private async Task PrimoDisegnoDallaCache()
    {
        try
        {
            var salvata = await Dati.IstantaneaLiveAsync(Codice, Utente.Tessera);
            if (salvata is null) return;

            var i = salvata.Valore;
            _torneo = i.Torneo;
            _turni = i.Turni;
            _turniGiocati = _turni.InOrdineDiGioco().ToList();
            // Il ripiego e' il turno della fotografia, non l'ultimo dell'elenco: con
            // piu' gironi sono turni diversi, e la classifica che stiamo per
            // disegnare appartiene a quello.
            _turnoScelto = _turniGiocati.FirstOrDefault(t => t.SonoQui) ?? i.Ultimo;

            _generale = ClassificaGenerale.Calcola(i.Torneo, i.Ultimo, i.Righe, i.Precedenti);
            _ultimoAggiornamento = salvata.AggiornatoIl;
        }
        catch (Exception)
        {
            // Fotografia illeggibile o scritta da una versione precedente: si
            // riparte dalla rete, come prima.
        }
    }

    private async Task CaricaTorneoETurni()
    {
        try
        {
            // L'elenco turni non lo chiede piu' la pagina: lo porta il polling a
            // ogni giro. Prima veniva scaricato due volte di fila all'ingresso.
            if (_torneo is null)
            {
                var tornei = await Dati.LiveTorneiAsync(Utente.Tessera);
                _torneo = tornei.Valore.FirstOrDefault(t => t.Codice == Codice);
            }

            if (_torneo is null)
            {
                _errore = "Torneo non trovato.";
                return;
            }

            AvviaPollingGenerale();
        }
        catch (Exception)
        {
            _errore = "Impossibile caricare il torneo.";
        }
    }

    // Un solo polling per volta: la vista che non si sta guardando non interroga
    // il server. Sono due schermate sullo stesso torneo, non due cose in parallelo.

    private void AvviaPollingGenerale()
    {
        if (_pollingGenerale is null || _torneo is null) return;

        _polling?.Ferma();
        _pollingGenerale.Configura(_torneo, _turnoScelto?.Girone ?? "", Utente.Tessera);
        _pollingGenerale.Avvia();
    }

    private void AvviaPolling()
    {
        if (_polling is null || _turnoScelto is null) return;

        _pollingGenerale?.Ferma();
        _polling.Configura(Codice, _turnoScelto.Codice, _turnoScelto.Girone, Utente.Tessera);
        _polling.Avvia();
    }

    private void MostraGenerale()
    {
        if (_vistaGenerale) return;

        _vistaGenerale = true;
        _errore = null;

        // La classifica calcolata resta in mano al polling: rientrando si rivede
        // subito, senza schermata vuota mentre arriva il primo giro. Ma solo se
        // parla dello stesso girone: dopo un cambio di girone e' di un'altra
        // competizione e mostrarla sarebbe sbagliato.
        var girone = _turnoScelto?.Girone ?? "";
        var precedente = _pollingGenerale?.Ultima;
        _generale = precedente is not null && precedente.Girone == girone ? precedente : null;
        _generaleInCaricamento = _generale is null;
        _ultimoAggiornamento = _generale is null ? null : _ultimoAggiornamento;

        AvviaPollingGenerale();
    }

    private void CambiaTurno(LiveTurno turno)
    {
        // Il confronto e' sulla chiave, non sul codice: quando il torneo si spezza
        // in gironi lo stesso "09-D" esiste per A, B, C e D. Confrontando i codici
        // i quattro chip risultavano tutti attivi insieme e toccarne uno non
        // faceva niente, perche' sembrava il turno gia' scelto.
        if (!_vistaGenerale && turno.Chiave == _turnoScelto?.Chiave) return;

        var cambiaGirone = turno.Girone != _turnoScelto?.Girone;

        _vistaGenerale = false;
        _turnoScelto = turno;

        // Cambiando girone anche la generale parla di un'altra competizione:
        // quella in memoria non vale piu'.
        if (cambiaGirone) _generale = null;

        _turnoInCaricamento = true;
        _righe = [];
        _miaRiga = null;
        _soloMioTavolo = false;
        _ultimoAggiornamento = null;
        _errore = null;

        AvviaPolling();
    }

    private Task SuAggiornamento(EsitoLive esito) => InvokeAsync(() =>
    {
        _righe = esito.Righe;
        _miaRiga = esito.Righe.FirstOrDefault(r => r.Dati.SonoIo);
        _turnoInCaricamento = false;
        _ultimoAggiornamento = esito.Momento;
        _errore = esito.Errore;
        _inAggiornamento = false;

        StateHasChanged();
    });

    private Task SuAggiornamentoGenerale(EsitoGenerale esito) => InvokeAsync(() =>
    {
        if (esito.Classifica is not null) _generale = esito.Classifica;
        _generaleInCaricamento = false;

        // I chip si riallineano da soli: quando l'arbitro chiude un turno, il giro
        // successivo porta gia' l'elenco aggiornato.
        if (esito.Turni is { Count: > 0 } turni)
        {
            _turni = turni;
            _turniGiocati = turni.InOrdineDiGioco().ToList();

            // Preselezione del turno singolo: quello che sto giocando, altrimenti
            // l'ultimo concluso. Serve solo alla prima volta, poi decide l'utente.
            _turnoScelto ??= _turniGiocati.FirstOrDefault(t => t.SonoQui)
                             ?? _turniGiocati.LastOrDefault();
        }

        _ultimoAggiornamento = esito.Momento;
        _errore = esito.Errore;
        _inAggiornamento = false;

        StateHasChanged();
    });

    private async Task AggiornaOra()
    {
        _inAggiornamento = true;

        if (_vistaGenerale)
        {
            if (_pollingGenerale is not null) await _pollingGenerale.AggiornaOra();
        }
        else if (_polling is not null)
        {
            await _polling.AggiornaOra();
        }
    }

    private bool MostraPulsanteVaiAMe => _vistaGenerale
        ? _generale?.Mia is not null && _generale.Righe.Count > 8
        : _miaRiga is not null && _righe.Count > 8;

    private async Task VaiAMe()
    {
        var id = _vistaGenerale
            ? _generale?.Mia is { } mia ? IdRiga(mia) : null
            : _miaRiga is not null ? IdRiga(_miaRiga) : null;

        if (id is null) return;
        await JS.InvokeVoidAsync("fitab.scorriA", id);
    }

    // Il backend fornisce i due giocatori sia uniti (DescrizioneCoppia) sia
    // separati: usiamo i separati quando ci sono, con fallback sulla stringa unica.
    private static string Primo(LiveRiga r) =>
        !string.IsNullOrWhiteSpace(r.Giocatore1) ? r.Giocatore1 : r.DescrizioneCoppia;

    private static string Secondo(LiveRiga r) =>
        !string.IsNullOrWhiteSpace(r.Giocatore1) ? r.Giocatore2 : "";

    private static string IdRiga(RigaLive riga) =>
        "riga-" + riga.Dati.Codice.Replace("-", "");

    // Nella generale la chiave e' quella stabile della coppia: il Codice di riga
    // cambia da un turno all'altro e farebbe puntare a un elemento che non c'e' piu'.
    private static string IdRiga(RigaGenerale riga) =>
        "gen-" + new string(riga.ChiaveCoppia.Where(char.IsLetterOrDigit).ToArray());

    /// <summary>VP guadagnati in un turno, col segno: "+13".</summary>
    private static string Segno(int valore) => valore > 0 ? $"+{valore}" : valore.ToString();

    protected override async Task OnAfterRenderAsync(bool primaVolta)
    {
        if (!primaVolta) return;

        // Sospende il polling quando l'app passa in background: non ha senso
        // interrogare il server di un torneo che nessuno sta guardando.
        _riferimento = DotNetObjectReference.Create(this);
        _idVisibilita = await JS.InvokeAsync<string>("fitab.osservaVisibilita", _riferimento);
    }

    [JSInvokable]
    public void CambioVisibilita(bool visibile)
    {
        var attivo = _vistaGenerale ? (PollingPrudente?)_pollingGenerale : _polling;
        if (attivo is null) return;

        if (visibile)
        {
            attivo.Riprendi();
            _ = attivo.AggiornaOra();
        }
        else
        {
            attivo.Sospendi();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_polling is not null)
        {
            _polling.Aggiornato -= SuAggiornamento;
            await _polling.DisposeAsync();
        }

        if (_pollingGenerale is not null)
        {
            _pollingGenerale.Aggiornato -= SuAggiornamentoGenerale;
            await _pollingGenerale.DisposeAsync();
        }

        if (_idVisibilita is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("fitab.dimenticaVisibilita", _idVisibilita);
            }
            catch (JSDisconnectedException)
            {
                // La WebView e' gia' chiusa: nulla da sganciare.
            }
        }

        _riferimento?.Dispose();
    }
}
