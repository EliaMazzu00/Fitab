@* Filigrana con i quattro semi delle carte, per la testata della home.
   Disegno nostro: i marchi della federazione non vanno mai usati come texture
   di sfondo, e un motivo che richiama il burraco fa lo stesso lavoro senza
   toccare l'identita' istituzionale. *@

<svg class="@Classe" viewBox="0 0 320 120" preserveAspectRatio="xMidYMid slice"
     xmlns="http://www.w3.org/2000/svg" fill="currentColor" aria-hidden="true">

    <g transform="translate(34 30) rotate(-14) scale(1.05)">@Cuori</g>
    <g transform="translate(96 84) rotate(11) scale(.8)">@Quadri</g>
    <g transform="translate(150 26) rotate(-6) scale(.9)">@Picche</g>
    <g transform="translate(214 88) rotate(16) scale(1)">@Fiori</g>
    <g transform="translate(272 34) rotate(-18) scale(.85)">@Quadri</g>
    <g transform="translate(66 60) rotate(24) scale(.55)">@Fiori</g>
    <g transform="translate(180 62) rotate(-10) scale(.6)">@Cuori</g>
    <g transform="translate(288 92) rotate(8) scale(.55)">@Picche</g>
</svg>

@code {
    [Parameter] public string? Classe { get; set; }

    // I quattro semi, centrati sull'origine del proprio gruppo.
    private static readonly MarkupString Cuori = new(
        """<path d="M0 14C-9 6-14 1-14-5c0-4 3-7 7-7 3 0 5 1 7 4 2-3 4-4 7-4 4 0 7 3 7 7 0 6-5 11-14 19z"/>""");

    private static readonly MarkupString Picche = new(
        """<path d="M0-16C-8-8-14-3-14 3c0 4 3 7 7 7 2 0 4-1 5-2-1 4-3 7-5 9h14c-2-2-4-5-5-9 1 1 3 2 5 2 4 0 7-3 7-7 0-6-6-11-14-19z"/>""");

    private static readonly MarkupString Quadri = new(
        """<path d="M0-16 12 0 0 16-12 0z"/>""");

    private static readonly MarkupString Fiori = new(
        """<path d="M0-16a6 6 0 0 1 4 10 6 6 0 1 1-8 7 6 6 0 0 0 8 0 6 6 0 1 1-4-17zM-2 8h4l2 9h-8z"/>""");
}
