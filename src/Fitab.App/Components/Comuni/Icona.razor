@* Icone inline. Niente font di icone ne' librerie: sono una dipendenza in piu',
   pesano al primo avvio e non si adattano al colore del tema con la stessa
   facilita'. Qui sono SVG a tratto, ereditano currentColor e la dimensione. *@

<svg class="@Classe" width="@Dimensione" height="@Dimensione" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Nome)
    {
        case "casa":
            <path d="M3 11l9-8 9 8v9a2 2 0 0 1-2 2h-4v-6H9v6H5a2 2 0 0 1-2-2z" />
            break;

        case "calendario":
            <path d="M8 2v4M16 2v4M3 10h18" />
            <rect x="3" y="4" width="18" height="18" rx="2" />
            break;

        case "diretta":
            <path d="M4.9 4.9a10 10 0 0 0 0 14.2M19.1 4.9a10 10 0 0 1 0 14.2" />
            <path d="M7.8 7.8a6 6 0 0 0 0 8.4M16.2 7.8a6 6 0 0 1 0 8.4" />
            <circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none" />
            break;

        case "medaglia":
            <circle cx="12" cy="9.5" r="5" />
            <path d="M8.6 13.6L7 22l5-2.8 5 2.8-1.6-8.4" />
            break;

        case "persona":
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
            break;

        case "aggiorna":
            <path d="M21 12a9 9 0 1 1-2.6-6.4" />
            <path d="M21 3v6h-6" />
            break;

        case "indietro":
            <path d="M15 18l-6-6 6-6" />
            break;

        case "avanti":
            <path d="M9 6l6 6-6 6" />
            break;

        case "documento":
            <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z" />
            <path d="M14 2v5h5M9 13h6M9 17h6" />
            break;

        case "luogo":
            <path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z" />
            <circle cx="12" cy="10" r="3" />
            break;

        case "orologio":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;

        case "tavolo":
            <path d="M3 10h18M5 10V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v3" />
            <path d="M6 10v9M18 10v9" />
            break;

        case "cerca":
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.3-4.3" />
            break;

        case "sole":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;

        case "luna":
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            break;

        case "automatico":
            @* Cerchio mezzo pieno: il simbolo consueto del "segui il sistema" *@
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none" />
            break;

        case "nessuna-rete":
            <path d="M1 1l22 22" />
            <path d="M5 12.5a10 10 0 0 1 4-2.4M2 8.8a15 15 0 0 1 4.3-2.6M17 6.2A15 15 0 0 1 22 8.8M15.5 10.2a10 10 0 0 1 3.5 2.3" />
            <path d="M8.5 16.1a5 5 0 0 1 7 0" />
            <circle cx="12" cy="20" r="1" fill="currentColor" stroke="none" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Nome { get; set; } = "";

    /// <summary>Dimensione in pixel. 24 e' il default; nelle tab usiamo 26.</summary>
    [Parameter] public int Dimensione { get; set; } = 24;

    [Parameter] public string? Classe { get; set; }
}
